{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/RecordMX",
  "title": "RecordMX",
  "type": "object",
  "properties": {
    "_ref": {
      "type": "string",
      "description": "The object reference for this MX record."
    },
    "name": {
      "type": "string",
      "description": "The domain name."
    },
    "mail_exchanger": {
      "type": "string",
      "description": "The mail exchanger hostname."
    },
    "preference": {
      "type": "integer",
      "description": "The preference value (lower values have higher priority).",
      "minimum": 0,
      "maximum": 65535
    },
    "view": {
      "type": "string",
      "description": "The DNS view."
    },
    "comment": {
      "type": "string",
      "description": "A descriptive comment.",
      "maxLength": 256
    }
  }
}