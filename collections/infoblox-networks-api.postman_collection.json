          "name": "Infoblox List DHCP networks",
          "request": {
            "name": "Infoblox List DHCP networks",
            "description": {
              "content": "Retrieves a list of IPv4 networks. Networks represent IP subnets and can contain DHCP ranges and fixed addresses. Supports filtering by network address, CIDR, network view, and comment.",
              "type": "text/plain"
            },
