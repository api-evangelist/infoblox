      "name": "IP Address Management",
      "description": {
        "content": "Operations for managing IP addresses, querying address utilization, and performing next available IP lookups.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "adcae145-3cce-48f5-b109-a66cd6dda27b",
          "name": "Infoblox List IPv4 addresses",
          "request": {
            "name": "Infoblox List IPv4 addresses",
            "description": {
              "content": "Retrieves a list of IPv4 address objects. This is a read-only object that provides information about the usage and status of IPv4 addresses in the Infoblox system. Supports filtering by IP address, network, status, and associated names.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ipv4address"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "_return_fields",
                  "value": "<string>",
                  "description": "Comma-separated list of field names to include in the response. Use _return_fields+ to add fields to the default set."
                },
                {
                  "disabled": false,
                  "key": "_max_results",
                  "value": "1000",
                  "description": "The maximum number of results to return. The default is 1000. Use a negative value to return all results."
                },
                {
                  "disabled": false,
                  "key": "ip_address",
                  "value": "<ipv4>",
                  "description": "Filter by the IPv4 address."
                },
                {
                  "disabled": false,
                  "key": "network",
                  "value": "<string>",
                  "description": "Filter by the network in CIDR notation."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by the IP address status."
                },
                {
                  "disabled": false,
                  "key": "network_view",
                  "value": "<string>",
                  "description": "Filter by the network view name."
                }
              ],
              "variable": [
                {
                  "description": "The hostname or IP address of the Infoblox NIOS Grid Master appliance.",
                  "type": "any",
                  "value": "{{grid-master}}",
                  "key": "grid-master"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
