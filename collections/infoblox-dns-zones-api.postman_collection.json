                },
                {
                  "disabled": false,
                  "key": "_max_results",
                  "value": "1000",
                  "description": "The maximum number of results to return. The default is 1000. Use a negative value to return all results."
                },
                {
                  "disabled": false,
                  "key": "fqdn",
                  "value": "<string>",
                  "description": "Filter by the fully qualified domain name of the zone."
