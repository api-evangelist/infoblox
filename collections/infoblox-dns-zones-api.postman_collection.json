          "name": "Infoblox List authoritative DNS zones",
          "request": {
            "name": "Infoblox List authoritative DNS zones",
            "description": {
              "content": "Retrieves a list of authoritative DNS zones. Supports filtering by FQDN, view, and zone format (forward or reverse).",
